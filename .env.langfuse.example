ENCRYPTION_KEY=replace-with-a-64-character-hex-key
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=langfuse-minio:9000
MINIO_SSL=false
LANGFUSE_INIT_ORG_ID=org_123
